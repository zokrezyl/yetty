# Build directories — anchor to repo root so we don't accidentally swallow
# files named `build-*` deeper in the tree (e.g. .github/workflows/build-*.yml,
# build-tools/web/build-toybox.sh, build-tools/3rdparty/<lib>/build.sh, …).
/build-*
!/build-tools
tmp/

# IDE/editor
.cache/
.vscode/
compile_commands.json

# Python bytecode cache (qa-tools/, codegen, ffi-codegen, …)
__pycache__/
*.pyc

# Object files and build artifacts
*.o
*.d
*.a
*.so

# QEMU build artifacts
poc/qemu/build-tools/qemu-*/
poc/qemu/build-tools/*.tar.xz

# TinyEMU build artifacts
src/tinyemu/*.o
src/tinyemu/*.d
src/tinyemu/js/
src/tinyemu/Makefile.js
src/tinyemu/Untitled
.buckconfig.local

node_modules/
package-lock.json
package.json

# Re-include the alpine-extended-disk fs/ overlay tree. The `*.d` rule
# above is meant to catch Make/Ninja dependency files (foo.c.d), but
# also matches /etc/sudoers.d/ and /etc/profile.d/ inside the produced
# rootfs. Both `**/` (dirs) and `**` (files) — git can't re-include a
# file under a directory that's still excluded, so the dir negation
# must come first.
!/build-tools/3rdparty/*/fs/**/
!/build-tools/3rdparty/*/fs/**
