# Build outputs (per-host, never committed).
build-linux/
build-darwin/
build-freebsd/
build-ios-sim-x86_64/
build-tvos-arm64/
build-windows/
build-windows-debug/
build-windows-release/
build/

# Cross-file rendered by build-tools/{ios,tvos}/setup.sh with absolute
# SDK + toolchain paths — host-specific, never committed.
build-tools/ios/cross-*.generated.txt
build-tools/tvos/cross-*.generated.txt

# Xcode project generated by xcodegen from
# build-tools/tvos/project/project.yml. Stub project, no human edits.
build-tools/tvos/project/yos-tvos.xcodeproj/

# Nix build artifacts. With `src = self` in flake.nix and a dirty
# git tree, Nix flakes hash every untracked file under the repo
# root. Without these excludes, dropping a probe into tmp/ or even
# touching the result symlink invalidates the .#all derivation
# hash — every subsequent `nix build` or `./tools/yos.sh` rebuilds
# the full umbrella tree (yos + zsh + nvim + freebsd-tools + ~10
# library deps), even though no source actually changed.
result
result-*
.local/

# Scratch dir for build logs, probes, traces, throwaway scripts.
# Same Nix-source-hash reasoning as above — DO NOT remove.
tmp/

# Stray crash dumps / error reports.
perror.*

# Python venv (bootstrapped via `uv sync`).
.venv/
__pycache__/
*.pyc

# Editor / OS noise.
.DS_Store
*.swp

# runit server-mode state. The service scripts under runtime/runit/<svc>/
# are tracked (run, log/run). Everything else is generated at runtime:
#   - supervise/         runsv's per-service control sockets + status
#   - log/main           svlogd's rotating buffer dir
#   - logs/              the --log-dir catch-all + per-service spool
runtime/runit/*/supervise/
runtime/runit/*/log/supervise/
runtime/runit/*/log/main/
runtime/logs/

# clangd index cache
.cache/
