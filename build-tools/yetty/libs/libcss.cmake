# libcss — NetSurf's MIT-licensed CSS cascade, plus its two MIT deps
# (libparserutils + libwapcaplet). Built IN-TREE from the vendored source
# under src/libcss/, the same way vterm.cmake builds src/libvterm-0.3.3.
#
# There is no prebuilt tarball and no NetSurf GNU-make buildsystem here:
# CMake compiles the sources directly, so libcss uses the exact same
# compiler / archiver / sysroot as the rest of yetty. That removes the
# make/perl toolchain requirement and the fragile CC/AR derivation the
# make build depended on.
#
# Exposed targets (names unchanged from the old prebuilt path, so
# consumers — src/yetty/ybrowser — need no edits):
#   libwapcaplet_static     — interned-string pool
#   libparserutils_static   — tokenizer / input stream used by libcss
#   libcss_static           — the CSS cascade (links the other two)
#
# Consumers guard with `if(TARGET libcss_static)` and fall back to the
# built-in lexbor-CSS path when it is absent (unsupported platforms).
#
# Property parsers: libcss generates one
# src/parse/properties/autogenerated_<prop>.c per line of properties.gen
# via a tiny host generator (css_property_parser_gen.c). The generated
# text is architecture-independent, so we build the generator with the
# BUILD MACHINE's compiler and run it at configure time — correct for
# native and cross builds alike. (The select/ property tables ship as
# committed autogenerated_*.h; only the parse/ parsers are generated.)

include_guard(GLOBAL)

if(TARGET libcss_static)
    return()
endif()

set(LIBCSS_ROOT ${YETTY_ROOT}/src/libcss)
if(NOT EXISTS ${LIBCSS_ROOT}/libcss/src/select/select.c)
    message(STATUS "libcss: vendored source not found at ${LIBCSS_ROOT} — skipping (lexbor-CSS fallback)")
    return()
endif()

# NetSurf's C sources build cleanly on desktop Linux and macOS. The other
# yetty targets (MSVC, emscripten, Android, iOS/tvOS) were never built by
# the old make path either — they used an UNSUPPORTED placeholder and the
# lexbor-CSS fallback. Keep that behaviour: only build libcss on Linux and
# macOS (the riscv64 / aarch64 Linux cross-builds report SYSTEM_NAME=Linux
# and are supported).
if(NOT (CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin"))
    message(STATUS "libcss: ${CMAKE_SYSTEM_NAME} unsupported — skipping (lexbor-CSS fallback)")
    return()
endif()

# ---------------------------------------------------------------------------
# Generate the parse-property parsers.
#
# The generator runs on the build host (arch-independent output), so it is
# compiled with the build machine's own compiler — NOT CMAKE_C_COMPILER,
# which on a cross build targets the guest. Regenerate only when the input
# (properties.gen or the generator source) is newer than the last run.
# ---------------------------------------------------------------------------
set(LIBCSS_PROP_DIR ${LIBCSS_ROOT}/libcss/src/parse/properties)
set(LIBCSS_GEN_DIR  ${CMAKE_BINARY_DIR}/libcss-gen/parse/properties)
set(LIBCSS_GEN_STAMP ${CMAKE_BINARY_DIR}/libcss-gen/.stamp)

if(NOT EXISTS ${LIBCSS_GEN_STAMP}
   OR ${LIBCSS_PROP_DIR}/properties.gen IS_NEWER_THAN ${LIBCSS_GEN_STAMP}
   OR ${LIBCSS_PROP_DIR}/css_property_parser_gen.c IS_NEWER_THAN ${LIBCSS_GEN_STAMP})

    find_program(LIBCSS_BUILD_CC NAMES cc gcc clang)
    if(NOT LIBCSS_BUILD_CC)
        message(FATAL_ERROR
            "libcss: no host C compiler (cc/gcc/clang) found to build the \
property-parser generator")
    endif()

    file(MAKE_DIRECTORY ${LIBCSS_GEN_DIR})
    set(_libcss_gen_parser ${CMAKE_BINARY_DIR}/libcss-gen/gen_parser)

    message(STATUS "libcss: building property-parser generator (${LIBCSS_BUILD_CC})")
    execute_process(
        COMMAND ${LIBCSS_BUILD_CC} -O0 -o ${_libcss_gen_parser}
                ${LIBCSS_PROP_DIR}/css_property_parser_gen.c
        RESULT_VARIABLE _libcss_gen_cc_rc)
    if(NOT _libcss_gen_cc_rc EQUAL 0)
        message(FATAL_ERROR "libcss: failed to build gen_parser (rc=${_libcss_gen_cc_rc})")
    endif()

    # Each non-comment line of properties.gen is "<prop>:<descriptor…>". The
    # property name (up to the first ':') selects the output file; the whole
    # line is the single descriptor argument the generator expects.
    file(STRINGS ${LIBCSS_PROP_DIR}/properties.gen _libcss_prop_lines)
    set(_libcss_gen_count 0)
    foreach(_line IN LISTS _libcss_prop_lines)
        if(_line MATCHES "^[^#][^:]+:")
            string(REGEX REPLACE "^([^:]+):.*$" "\\1" _prop "${_line}")
            execute_process(
                COMMAND ${_libcss_gen_parser} -o
                        ${LIBCSS_GEN_DIR}/autogenerated_${_prop}.c
                        "${_line}"
                RESULT_VARIABLE _libcss_gen_rc)
            if(NOT _libcss_gen_rc EQUAL 0)
                message(FATAL_ERROR
                    "libcss: gen_parser failed for '${_prop}' (rc=${_libcss_gen_rc})")
            endif()
            math(EXPR _libcss_gen_count "${_libcss_gen_count} + 1")
        endif()
    endforeach()
    file(WRITE ${LIBCSS_GEN_STAMP} "")
    message(STATUS "libcss: generated ${_libcss_gen_count} property parsers")
endif()

file(GLOB LIBCSS_GEN_SOURCES CONFIGURE_DEPENDS
    ${LIBCSS_GEN_DIR}/autogenerated_*.c)

# ---------------------------------------------------------------------------
# Generate the libparserutils charset-alias table.
#
# make-aliases.pl reads build/Aliases and writes src/charset/aliases.inc
# (arch-independent text, #included by src/charset/aliases.c). It resolves
# both paths relative to its working directory, so we run it in a staging
# dir under the build tree (seeded with a copy of build/Aliases) and put the
# result on the include path — the source tree stays clean.
# ---------------------------------------------------------------------------
set(LIBPARSERUTILS_GEN_DIR ${CMAKE_BINARY_DIR}/libcss-gen/parserutils)
set(LIBPARSERUTILS_ALIASES_INC ${LIBPARSERUTILS_GEN_DIR}/src/charset/aliases.inc)

if(NOT EXISTS ${LIBPARSERUTILS_ALIASES_INC}
   OR ${LIBCSS_ROOT}/libparserutils/build/Aliases IS_NEWER_THAN ${LIBPARSERUTILS_ALIASES_INC}
   OR ${LIBCSS_ROOT}/libparserutils/build/make-aliases.pl IS_NEWER_THAN ${LIBPARSERUTILS_ALIASES_INC})

    find_program(LIBCSS_PERL NAMES perl)
    if(NOT LIBCSS_PERL)
        message(FATAL_ERROR
            "libcss: perl not found — needed to generate the libparserutils \
charset-alias table (src/charset/aliases.inc)")
    endif()

    file(MAKE_DIRECTORY
        ${LIBPARSERUTILS_GEN_DIR}/build
        ${LIBPARSERUTILS_GEN_DIR}/src/charset)
    configure_file(${LIBCSS_ROOT}/libparserutils/build/Aliases
                   ${LIBPARSERUTILS_GEN_DIR}/build/Aliases COPYONLY)

    message(STATUS "libcss: generating libparserutils charset-alias table (${LIBCSS_PERL})")
    execute_process(
        COMMAND ${LIBCSS_PERL} ${LIBCSS_ROOT}/libparserutils/build/make-aliases.pl
        WORKING_DIRECTORY ${LIBPARSERUTILS_GEN_DIR}
        RESULT_VARIABLE _libcss_aliases_rc)
    if(NOT _libcss_aliases_rc EQUAL 0)
        message(FATAL_ERROR "libcss: make-aliases.pl failed (rc=${_libcss_aliases_rc})")
    endif()
    if(NOT EXISTS ${LIBPARSERUTILS_ALIASES_INC})
        message(FATAL_ERROR "libcss: make-aliases.pl produced no aliases.inc")
    endif()
endif()

# ---------------------------------------------------------------------------
# The three static libraries.
#
# Compile flags mirror what NetSurf's buildsystem passed: C99, the BSD/
# default feature macros, the _ALIGNED alignment-attribute macro, and the
# STMTEXPR opt-in for statement expressions. Warnings are suppressed (-w),
# same as the vendored vterm build — this is upstream source we do not lint.
# ---------------------------------------------------------------------------
set(_libcss_defs
    _BSD_SOURCE
    _DEFAULT_SOURCE
    "_ALIGNED=__attribute__((aligned))"
    STMTEXPR=1)

# libwapcaplet (leaf) --------------------------------------------------------
file(GLOB_RECURSE LIBWAPCAPLET_SOURCES CONFIGURE_DEPENDS
    ${LIBCSS_ROOT}/libwapcaplet/src/*.c)
add_library(libwapcaplet_static STATIC ${LIBWAPCAPLET_SOURCES})
target_include_directories(libwapcaplet_static
    PUBLIC  ${LIBCSS_ROOT}/libwapcaplet/include
    PRIVATE ${LIBCSS_ROOT}/libwapcaplet/src)
target_compile_definitions(libwapcaplet_static PRIVATE ${_libcss_defs})
target_compile_options(libwapcaplet_static PRIVATE -std=c99 -w)

# libparserutils (leaf) ------------------------------------------------------
file(GLOB_RECURSE LIBPARSERUTILS_SOURCES CONFIGURE_DEPENDS
    ${LIBCSS_ROOT}/libparserutils/src/*.c)
add_library(libparserutils_static STATIC ${LIBPARSERUTILS_SOURCES})
target_include_directories(libparserutils_static
    PUBLIC  ${LIBCSS_ROOT}/libparserutils/include
    PRIVATE ${LIBCSS_ROOT}/libparserutils/src
            # generated aliases.inc (charset/aliases.c #includes it)
            ${LIBPARSERUTILS_GEN_DIR}/src/charset)
target_compile_definitions(libparserutils_static PRIVATE ${_libcss_defs})
target_compile_options(libparserutils_static PRIVATE -std=c99 -w)
# libparserutils calls iconv_open/close (src/input/filter.c). On Linux iconv
# is in glibc; macOS ships it as a separate libiconv that must be linked.
if(APPLE)
    target_link_libraries(libparserutils_static PUBLIC iconv)
endif()

# libcss (links the two leaves) ---------------------------------------------
# Every hand-written .c under libcss/src EXCEPT the generator itself, plus
# the generated parse-property parsers.
file(GLOB_RECURSE LIBCSS_HAND_SOURCES CONFIGURE_DEPENDS
    ${LIBCSS_ROOT}/libcss/src/*.c)
list(REMOVE_ITEM LIBCSS_HAND_SOURCES
    ${LIBCSS_PROP_DIR}/css_property_parser_gen.c)
add_library(libcss_static STATIC ${LIBCSS_HAND_SOURCES} ${LIBCSS_GEN_SOURCES})
target_include_directories(libcss_static
    PUBLIC  ${LIBCSS_ROOT}/libcss/include
    PRIVATE ${LIBCSS_ROOT}/libcss/src)
target_compile_definitions(libcss_static PRIVATE ${_libcss_defs})
target_compile_options(libcss_static PRIVATE -std=c99 -w)
target_link_libraries(libcss_static PUBLIC libparserutils_static libwapcaplet_static)

message(STATUS "libcss: in-tree build from ${LIBCSS_ROOT}")
