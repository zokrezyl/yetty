{
  "version": 1,
  "defaults": {
    "ycat_args": ["-w", "100"],
    "timeout_seconds": 120
  },
  "scenarios": [
    {
      "id": "svg-de-flag",
      "description": "SVG with plain rect fills -> minimal SDF box primitives",
      "input": "demo/assets/svg/de-flag.svg"
    },
    {
      "id": "svg-smoke",
      "description": "SVG smoke sample -> path/shape translation",
      "input": "demo/assets/svg/smoke.svg"
    },
    {
      "id": "svg-logo",
      "description": "SVG logo with nested paths and text",
      "input": "demo/assets/svg/svg-logo.svg"
    },
    {
      "id": "svg-tiger",
      "description": "Classic tiger.svg — large path-heavy stress input",
      "input": "demo/assets/svg/tiger.svg"
    },
    {
      "id": "markdown-overview",
      "description": "Markdown rendering: headings, lists, emphasis, code",
